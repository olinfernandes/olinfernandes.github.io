---
import { getEntry } from "astro:content";
import Layout from "../layouts/Base.astro";

const entry = await getEntry("copy", "2024-07-14-homecopy");

if (!entry) {
  throw new Error(
    'Entry "2024-07-14-homecopy" not found in collection "copy".',
  );
}

const {
  data: { draft },
} = entry;

const { Content } = await entry.render();
---

<Layout>
  {!draft && <Content />}
  <div class="center">
    <a href="https://www.buymeacoffee.com/olinfernandes" target="__blank"
      ><img
        src="https://img.buymeacoffee.com/button-api/?text=Buy me a coffee&emoji=☕&slug=olinfernandes&button_colour=40DCA5&font_colour=ffffff&font_family=Poppins&outline_colour=000000&coffee_colour=FFDD00"
      /></a
    >
  </div>
</Layout>

<style>
  .center {
    display: block;
    margin-top: 4rem;
  }
  .center a img {
    margin: auto;
  }
</style>
