---
import { getEntry } from "astro:content";
import Layout from "../layouts/BlogPost.astro";

const entry = (await getEntry("copy", "2024-07-15-aboutcopy"))!;
const {
  data: { title, pubDate, draft, heroImage },
} = entry;
const { Content } = await entry.render();
---

<Layout title={title} description='' pubDate={pubDate} heroImage={heroImage}>
  {!draft && <Content />}
</Layout>
