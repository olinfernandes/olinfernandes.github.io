---
import type { CollectionEntry } from "astro:content";
import { Picture } from "astro:assets";
import Layout from "../layouts/Base.astro";
import FormattedDate from "../components/FormattedDate.astro";

type Props = CollectionEntry<"blog">["data"];

const { title, description, pubDate, heroImage } = Astro.props;
---

<Layout title={title} description={description}>
  <article>
    <div class="hero-image" id="hero-image">
      {heroImage && <Picture src={heroImage} alt="" />}
    </div>
    <div class="prose">
      <div class="title" id="title">
        <div class="date">
          Posted on <FormattedDate date={pubDate} />
          <slot name="read-time" />
        </div>
        <h1>{title}</h1>
        <hr />
      </div>
      <slot />
    </div>
  </article>
</Layout>

<style>
  main {
    width: calc(100% - 2em);
    max-width: 100%;
    margin: 0;
  }
  .hero-image {
    width: 100%;
    max-width: 1024px;
  }
  .hero-image img {
    display: block;
    aspect-ratio: 16 / 9;
    margin: 0 auto;
    border-radius: 12px;
    box-shadow: var(--box-shadow);
  }
  .prose {
    width: 720px;
    max-width: calc(100% - 2em);
    margin: auto;
    padding: 1em;
    color: rgb(var(--gray-dark));
  }
  .title {
    margin-bottom: 1em;
    padding: 1em 0;
    text-align: center;
    line-height: 1;
  }
  .title h1 {
    margin: 0 0 0.5em 0;
  }
  .date {
    margin-bottom: 0.5em;
    color: rgb(var(--gray));
  }
  .last-updated-on {
    font-style: italic;
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    document.getElementById("title")?.scrollIntoView();
  });
</script>
